GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

# Email (Gmail: enable 2FA, then create an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password

# Optional: default student list (comma separated) used when teacher doesn't give emails
STUDENT_EMAILS=
# Optional safety: only these domains/addresses may receive mail (comma separated, empty = allow all)
EMAIL_WHITELIST=
